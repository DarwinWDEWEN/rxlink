# AnalyticDB Supabase 项目配置 —— 复制本文件为 supabase/functions/.env 后填值。
# 本 .example 会进版本库，只留空值；真实 .env 已被 .gitignore 排除。
#
# 取值位置（详见 docs/reference/adb-supabase/project-access.md）：
#   URL        → 控制台 Supabase 列表 → App Frameworks 弹窗
#   anon/service key → Dashboard 左侧 Authentication 页；或 API Docs > Introduction > Bash 里选 key
#   PG 直连    → 项目 操作 > 修改白名单(加本机公网IP) > 重置数据库密码 > 登录 Dashboard > 跳转后的地址，端口 5432

SUPABASE_API_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 直连串，形如 postgresql://postgres:<密码>@<IP>:5432/postgres
# 本机没装 psql，这份串给 `supabase db query --db-url` 用（一次只能一条语句）
SUPABASE_DB_URL=

# 可选：配了 CDN 测试域名后用于项 1（路径透传与 x-forwarded-host）
PROBE_DOMAIN=

# 可选：只有 `supabase functions deploy` / `supabase db push` 需要（走阿里云 OpenAPI）。
# 不填也能推进：函数改用控制台粘贴部署，SQL 改用 db query --db-url。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
